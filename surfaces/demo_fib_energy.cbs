// --- Constants ---
const FIB_TARGET     = 12        // compute fib(12) = 144
const ENERGY_INITIAL = 100000    // starting metabolic budget (joules)

// --- Recursive Fibonacci ---
func fib(n) {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

// --- Main: compute, print result, print energy used ---
let result = fib(FIB_TARGET)

print("fib(")
print(FIB_TARGET)
print(") = ")
print(result)

