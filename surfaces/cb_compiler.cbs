// =============================================================================
// CBS Compiler Orchestrator: Lexer → Parser → Compiler
// Input:  Filename (.cbs)
// Output: Compiled .cbc file
// =============================================================================

func main() {
    let filename = vm_args[0]

    // 1. Run lexer
    vm_run("lexer_main.cbc", filename)
    let tokens = vm_read("lexer_tokens")
    if (tokens.error) return -1

    // 2. Run parser
    vm_run("parser_main.cbc")
    let ast = vm_read("parser_ast")
    if (ast.error) return -1

    // 3. Run compiler
    vm_run("compiler_main.cbc")
    let bytecode = vm_read("compiler_bytecode")
    if (bytecode.error) return -1

    return 0
}