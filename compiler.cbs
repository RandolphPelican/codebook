// compiler.cbs
// Phase 4: CodebookScript Compiler Implementation
// Pod 0: AST to Bytecode Translation.
// "Atreyu named it."

// Bytecode Instructions (Match ASM VM / runtime.py)
LOAD_CONST = 0x71
STORE      = 0x72
PRINT      = 0x73
RETURN     = 0x74

// Compiler function: Translate AST nodes into Codebook bytecode.
compiler :: AST -> [Byte]
compiler ast =
    match ast with
    | Program stmts -> 
        // Compile all statements and flatten the result
        foldl (\acc s -> acc + compiler s) [] stmts
    | Print s -> 
        // print "string" -> LOAD_CONST, STORE 'm', PRINT 'm'
        [LOAD_CONST] ++ encodeString s ++ [0x00, STORE, 109, PRINT, 109, RETURN]
    | Assign x expr -> 
        // x = expr -> Compile expr, then STORE x
        compiler expr ++ [STORE, encodeChar x, RETURN]
    | BinaryOp op left right ->
        // Simplified: Handle basic literal addition for now
        // Codebook VM expects stack-based or direct value handling
        compiler left ++ compiler right ++ [encodeOp op]
    | Number n ->
        // Numbers are treated as constants
        [LOAD_CONST] ++ encodeInt n ++ [0x00]
    | _ -> 
        error "Compiler Error: Unsupported AST node for translation"

// --- Internal Helpers ---

encodeString :: String -> [Byte]
encodeString s = map ord s

encodeChar :: String -> Byte
encodeChar s = ord (head s)

encodeInt :: Int -> [Byte]
encodeInt n = [n] // Simplified 1-byte encoding for dev phase

encodeOp :: String -> Byte
encodeOp "+" = 0x10 // OP_ADD in boot/defines.asm
encodeOp "-" = 0x11 // OP_SUB
encodeOp "*" = 0x12 // OP_MUL
encodeOp _   = 0xFF // Unknown
