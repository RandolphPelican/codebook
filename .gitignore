# build/ is normally ignored, EXCEPT the reference binary which is the
# Pod 0 exit-gate contract. Do NOT delete BOOTX64_reference.EFI.
build/*
!build/BOOTX64_reference.EFI

# Transient build artifacts
build.log

# Claude Code local state
.claude/

# Python bytecode
__pycache__/
*.pyc

# LLM context-prep artifacts — repo dumps, chunked exports, nested clones
codebook_full_dump.txt
codebook_full_history.txt
codebook_full_*.txt
codebook/
