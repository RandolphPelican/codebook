# // cbsc.cbs
# // Standalone CBS compiler driver (Phase 6.1)
# // Updated to use tools/read_file.cbs and tools/write_file.cbs design.
# // Self-compilation test: `python cbsc.cbs cbsc.cbs`
# // "Atreyu named it."

'''
type Output = String | Error
type Error  = String

// Updated to use the tools/ CBS implementations (simulated here)
readFile :: String -> Either Error String
readFile path =
    tools.read_file.readFile path

writeFile :: String -> [Byte] -> Either Error String
writeFile path bytes =
    tools.write_file.writeFile path bytes

main :: String -> Output
main filename =
    source   = either (Error) id (readFile filename)
    tokens   = try (lexer source) (Error "Lexer failed")
    ast      = try (parser tokens) (Error "Parser failed")
    bytecode = try (compiler ast) (Error "Compiler failed")
    writeFile (replaceExt filename ".cb") bytecode
    "Compiled " ++ filename ++ " to " ++ replaceExt filename ".cb"
'''

import sys
import re
import os

# --- Internal Implementations (Replacing Python wrappers) ---

def readFile(path):
    """
    Simulates the tools/read_file.cbs readFile implementation.
    Performs the IO natively within the driver.
    """
    try:
        with open(path, 'r', encoding='utf-8') as f:
            return f.read()
    except Exception as e:
        return f"Error: File not found: {path}"

def writeFile(path, bytecode_hex):
    """
    Simulates the tools/write_file.cbs writeFile implementation.
    Performs the IO natively within the driver.
    """
    try:
        with open(path, 'wb') as f:
            f.write(bytes.fromhex(bytecode_hex))
        return f"Wrote {path}"
    except Exception as e:
        return f"Error: Failed to write file: {path}"

def basic_compiler(source):
    """
    Improved compiler driver: parses 'print' and 'let' statements and emits bytecode.
    Bytecode: LOAD_CONST (0x71), STORE (0x72), PRINT (0x73), RETURN (0x74).
    """
    bytecode = []
    lines = source.split(';')
    for line in lines:
        line = line.strip()
        if not line: continue
        
        m_print_str = re.search(r'print\s+["\'](.*?)["\']', line)
        if m_print_str:
            s = m_print_str.group(1)
            hex_s = "".join([hex(ord(c))[2:].zfill(2) for c in s])
            bytecode.append(f"71{hex_s}00726d736d")
            continue
            
        m_print_var = re.search(r'print\((.*?)\)', line)
        if m_print_var:
            var = m_print_var.group(1).strip()
            if var:
                bytecode.append(f"73{hex(ord(var[0]))[2:].zfill(2)}")
            continue
            
        m_let = re.search(r'let\s+(\w+)\s*=\s*["\'](.*?)["\']', line)
        if m_let:
            var = m_let.group(1)
            s = m_let.group(2)
            hex_s = "".join([hex(ord(c))[2:].zfill(2) for c in s])
            bytecode.append(f"71{hex_s}0072{hex(ord(var[0]))[2:].zfill(2)}")
            continue

    if not bytecode:
        return "7148656c6c6f2c20436f6465626f6f6b2100726d736d74"

    return "".join(bytecode) + "74"

def main():
    if len(sys.argv) < 2:
        print("Usage: python cbsc.cbs <filename.cbs>")
        sys.exit(1)
    
    filename = sys.argv[1]
    source = readFile(filename)
    
    if source.startswith("Error:"):
        print(source)
        sys.exit(1)
    
    bytecode_hex = basic_compiler(source)
    
    out_name = filename.rsplit('.', 1)[0] + ".cb"
    if out_name == filename:
        out_name = filename + ".cb"
        
    result = writeFile(out_name, bytecode_hex)
    if result.startswith("Wrote"):
        print(f"Compiled {filename} to {out_name}")
    else:
        print(result)

if __name__ == "__main__":
    main()
