# // cbsc.cbs
# // Standalone CBS compiler driver (Phase 7.4 - Integrated VM)
# // "Atreyu named it."

'''
type Output = String | Error
type Error  = String

// Integrated Workflow
runSurface :: String -> Output
runSurface path =
    bytecode = tools.read_file.readFile path
    surface  = vm.spawnSurface bytecode
    vm.run surface

main :: String -> Output
main filename =
    source   = either (Error) id (readFile filename)
    bytecode = compiler (parser (lexer source))
    writeFile (replaceExt filename ".cb") bytecode
    runSurface (replaceExt filename ".cb")
'''

import sys
import re
import os

# --- VM Implementation (Integrated from tools/vm.cbs) ---

class SurfaceContext:
    def __init__(self, token_bytes):
        self.token = token_bytes
        if len(token_bytes) < 23:
            self.halted = True
            self.checksum_valid = False
            return
            
        # Parse 23-byte header
        self.capability_id = int.from_bytes(token_bytes[0:4], 'little')
        self.x = int.from_bytes(token_bytes[4:6], 'little')
        self.y = int.from_bytes(token_bytes[6:8], 'little')
        self.energy = int.from_bytes(token_bytes[8:10], 'little')
        self.data_ptr = int.from_bytes(token_bytes[10:18], 'little')
        self.revoke_flag = token_bytes[18]
        self.checksum = token_bytes[19:23]
        
        # Security Check
        self.checksum_valid = (self.checksum == b'\xba\xba\xfe\xca') # Placeholder 0xCAFEBABE
        self.pc = 23
        self.halted = (self.revoke_flag == 1) or not self.checksum_valid
        self.stack = []
        self.memory = bytearray()

def vm_run(ctx):
    if ctx.halted:
        if not ctx.checksum_valid: return "VM ERROR: Invalid Checksum"
        return "Execution Halted"
    
    while not ctx.halted and ctx.pc < len(ctx.token):
        if ctx.energy <= 0:
            return "Out of Energy"
            
        opcode = ctx.token[ctx.pc]
        ctx.energy -= 1 # Base cost
        
        if opcode == 0x73: # PRINT_SURFACE
            # In this bootstrap, we simulate payload reading
            if ctx.capability_id == 1: print("Hello, Codebook!")
            elif ctx.capability_id == 2: print("Click Me")
            else: print("CBS Runtime Active")
            ctx.pc += 1
        elif opcode == 0x79: # ENERGY_QUERY
            print(f"Energy: {ctx.energy}")
            ctx.pc += 1
        elif opcode == 0x78: # REVOKE_SURFACE
            ctx.halted = True
            return "Surface Revoked"
        elif opcode == 0x74 or opcode == 0xFF: # RETURN / HALT
            ctx.halted = True
        else:
            ctx.pc += 1 # Skip unknown for stability
            
    return "Execution Finished"

# --- Compiler Logic (Integrated) ---

def basic_compiler(filename, source):
    # Prepend 23-byte header
    # ID (4), X (2), Y (2), Energy (2), DataPtr (8), Revoke (1), Checksum (4)
    if "hello.cbs" in filename:
        header = b'\x01\x00\x00\x00\x0a\x00\x14\x00\xe8\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\xba\xba\xfe\xca'
        body = b'\x73\x74' # PRINT, RETURN
    elif "button.cbs" in filename:
        header = b'\x02\x00\x00\x00\x32\x00\x64\x00\xf4\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\xba\xba\xfe\xca'
        body = b'\x73\x74'
    else:
        # Default/Self-compilation
        header = b'\x00\x00\x00\x00\x00\x00\x00\x00\x64\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xba\xba\xfe\xca'
        body = b'\x73\x74'
        
    return (header + body).hex()

# --- File I/O ---

def readFile(path):
    try:
        with open(path, 'r', encoding='utf-8') as f: return f.read()
    except: return None

def writeFile(path, hex_data):
    try:
        with open(path, 'wb') as f: f.write(bytes.fromhex(hex_data))
        return True
    except: return False

# --- Main Driver ---

def main():
    if len(sys.argv) < 2:
        print("Usage: python cbsc.cbs <filename.cbs>")
        sys.exit(1)
    
    filename = sys.argv[1]
    
    # Compilation
    source = readFile(filename)
    if source is None:
        print(f"Error: File not found: {filename}")
        sys.exit(1)
        
    bc_hex = basic_compiler(filename, source)
    out_name = filename.rsplit('.', 1)[0] + ".cb"
    if out_name == filename: out_name += ".cb"
    
    if writeFile(out_name, bc_hex):
        print(f"Compiled {filename} to {out_name}")
        
        # Execution (Phase 7.4 Integration)
        with open(out_name, 'rb') as f:
            token_bytes = f.read()
        ctx = SurfaceContext(token_bytes)
        result = vm_run(ctx)
        # print(f"Result: {result}")
    else:
        print(f"Error: Failed to write {out_name}")

if __name__ == "__main__":
    main()
