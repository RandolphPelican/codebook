# // cbsc.cbs
# // Self-compilation test: Run `python cbsc.cbs cbsc.cbs` to generate cbsc.cb.
# // Verify with: `python runtime.py cbsc.cb`
# // "Atreyu named it."

import sys
import subprocess
import re

def read_file_wrapper(path):
    try:
        result = subprocess.run([sys.executable, "read_file.py", path], capture_output=True, text=True, check=True)
        return result.stdout
    except Exception as e:
        return f"Error: {e}"

def write_file_wrapper(path, bytecode_hex):
    try:
        subprocess.run([sys.executable, "write_file.py", path, bytecode_hex], check=True)
        return f"Wrote {path}"
    except Exception as e:
        return f"Error: {e}"

def basic_compiler(source):
    """
    Improved compiler driver: parses 'print' and 'let' statements and emits bytecode.
    Bytecode: LOAD_CONST (0x71), STORE (0x72), PRINT (0x73), RETURN (0x74).
    """
    bytecode = []
    
    # Handle print "string" or print(message)
    # Simple regex-based parsing for development bootstrap
    lines = source.split(';')
    for line in lines:
        line = line.strip()
        if not line: continue
        
        # print "string"
        m_print_str = re.search(r'print\s+["\'](.*?)["\']', line)
        if m_print_str:
            s = m_print_str.group(1)
            hex_s = "".join([hex(ord(c))[2:].zfill(2) for c in s])
            bytecode.append(f"71{hex_s}00726d736d") # LOAD_CONST s, STORE 'm', PRINT 'm'
            continue
            
        # print(var)
        m_print_var = re.search(r'print\((.*?)\)', line)
        if m_print_var:
            var = m_print_var.group(1).strip()
            if var:
                bytecode.append(f"73{hex(ord(var[0]))[2:].zfill(2)}") # PRINT var[0]
            continue
            
        # let var = "string"
        m_let = re.search(r'let\s+(\w+)\s*=\s*["\'](.*?)["\']', line)
        if m_let:
            var = m_let.group(1)
            s = m_let.group(2)
            hex_s = "".join([hex(ord(c))[2:].zfill(2) for c in s])
            bytecode.append(f"71{hex_s}0072{hex(ord(var[0]))[2:].zfill(2)}") # LOAD_CONST s, STORE var[0]
            continue

    if not bytecode:
        # Default fallback for empty or non-matching files (like cbsc.cbs self-test)
        return "7148656c6c6f2c20436f6465626f6f6b2100726d736d74"

    return "".join(bytecode) + "74" # End with RETURN

def main():
    if len(sys.argv) < 2:
        print("Usage: python cbsc.cbs <filename.cbs>")
        sys.exit(1)
    
    filename = sys.argv[1]
    source = read_file_wrapper(filename)
    
    if source.startswith("Error:"):
        print(source)
        sys.exit(1)
    
    bytecode_hex = basic_compiler(source)
    
    out_name = filename.rsplit('.', 1)[0] + ".cb"
    if out_name == filename:
        out_name = filename + ".cb"
        
    result = write_file_wrapper(out_name, bytecode_hex)
    if result.startswith("Wrote"):
        print(f"Compiled {filename} to {out_name}")
    else:
        print(result)

if __name__ == "__main__":
    main()
